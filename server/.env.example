# Copy this file to .env and fill in what you need.

PORT=4000

# MongoDB connection string (local or MongoDB Atlas).
# Leave empty in development to use a built-in local database stored in server/.data
MONGODB_URI=

# Long random string used to sign login cookies. Required in production.
JWT_SECRET=

# Where the React app runs (for CORS and links in emails).
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Outgoing email (SMTP). Leave SMTP_HOST empty in development:
# emails are then recorded in the app (Settings > Your data > Sent emails) instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# How often the follow-up scheduler runs, in milliseconds.
SCHEDULER_MS=60000
